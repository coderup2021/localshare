{
  "name": "localshare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "backend/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "build": "bun run --workspaces --parallel --if-present build",
    "typecheck": "tsc --noEmit -p tsconfig.json && bun run --workspaces --parallel --if-present typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "bun run --workspaces --parallel --if-present test",
    "e2e:prepare": "bun run scripts/prepare-e2e.ts",
    "test:e2e": "bun run e2e:prepare && playwright test",
    "check": "bun run typecheck && bun run lint && bun run test && bun run build && bun run test:e2e",
    "db:generate": "bun run --cwd backend/server db:generate",
    "db:migrate": "bun run --cwd backend/server db:migrate",
    "graph:index": "codegraph index .",
    "graph:sync": "codegraph sync .",
    "graph:status": "codegraph status ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
